{
  "name": "spoovault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:contracts": "npx hardhat test --config hardhat.config.cjs",
    "test:stellar": "cd contracts-stellar && cargo test",
    "test:smoke": "node scripts/smoke-check.mjs",
    "test:baseline": "node scripts/test-baseline.mjs",
    "test:sss": "node scripts/test-sss.mjs",
    "deploy:contract": "node scripts/deploy.mjs",
    "e2e:deploy": "node e2e/scripts/deploy-anvil.mjs",
    "e2e:install": "npx playwright install chromium && HEADLESS=true npx @synthetixio/synpress@4.1.2 e2e/wallet-setup",
    "e2e:evm": "HEADLESS=true npx playwright test",
    "e2e:stellar": "node e2e/soroban/soroban-flow.test.mjs",
    "proxy:pinata": "node scripts/pinata-proxy.mjs"
  },
  "dependencies": {
    "@heroui/react": "^2.0.0",
    "@heroui/theme": "^2.0.0",
    "@metamask/eth-sig-util": "^8.2.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@stellar/freighter-api": "^2.0.0",
    "@stellar/stellar-sdk": "^12.1.0",
    "@tanstack/react-virtual": "^3.14.10",
    "axios": "^1.6.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "ethers": "^6.13.0",
    "framer-motion": "^11.5.6",
    "mlkem": "^2.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.11.0",
    "react-router-dom": "^6.20.0",
    "tweetnacl": "^1.0.3",
    "web3.storage": "^4.5.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.14",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@playwright/test": "^1.48.0",
    "@synthetixio/synpress": "^4.1.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/mocha": "^10.0.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.14",
    "happy-dom": "^20.11.6",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^2.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.31",
    "solidity-coverage": "^0.8.17",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "^5.0.2",
    "vite": "^5.0.0",
    "vitest": "^4.1.10"
